{
	"extends": ["@vue/tsconfig/tsconfig.dom.json", "../tsconfig.base.json"],
	"include": [
		"cssVariables.d.ts",
		"tailwind.config.js",
		"env.d.ts",
		"./src/**/*.js",
		"./src/**/*.vue",
		"./src/**/*.ts",
		"./src/**/*.d.ts",
		"components.d.ts",
		"../api/src/**/*"
	],
	"exclude": ["src/**/__tests__/*"],
	"compilerOptions": {
		"allowJs": true,
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
