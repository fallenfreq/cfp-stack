index 9b0758e9c09772486dd342cf563d710cc26eddf1..2d3dc56ced371cef7fc1e908fdc3ed304b330095 100644
--- a/dist/vue-router.cjs
+++ b/dist/vue-router.cjs
@@ -589,6 +589,12 @@ function useHistoryListeners(base, historyState, currentLocation, replace) {
             delta = fromState ? state.position - fromState.position : 0;
         }
         else {
+            // Patched (cfp-stack, patches/vue-router@4.5.1.patch): a `#` that changed the address is a
+            // new entry, after the one before; to the address shown, the browser reused the entry. A
+            // bare `#` is left out of `to` and `from`, and out of the address once seen, so one there
+            // is new.
+            if (to !== from || location.href.endsWith('#'))
+                historyState.value = assign({}, fromState, { back: from, forward: null, position: fromState.position + 1 });
             replace(to);
         }
         // Here we could also revert the navigation by calling history.go(-delta)
