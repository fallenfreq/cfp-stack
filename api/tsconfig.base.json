{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["esnext"],
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true,
		"sourceMap": true,
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo",
		// Generate d.ts files
		"declaration": true,
		"types": ["@cloudflare/workers-types"]
	}
}
