{
	"name": "@somefreq-app/api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		"./appRouter": {
			"types": "./src/routes/appRouter.ts"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"dev": "concurrently \"npm run build:watch\" \"npx wrangler pages dev ./client_dist --live-reload\"",
		"build:watch": "tsc --build -w --noCheck",
		"build": "rm -rf dist functions .tsbuildinfo && tsc --build --noCheck",
		"type-check": "tsc -p tsconfig.check.json",
		"test": "node --test 'test/*.test.mjs'",
		"migrate": "pnpm drizzle-kit generate:sqlite",
		"migrate:custom": "pnpm drizzle-kit generate:sqlite --custom",
		"migrate:push:local": "npx wrangler d1 migrations apply somefreq-db --local",
		"migrate:push": "npx wrangler d1 migrations apply somefreq-db --remote",
		"logging": "npx wrangler pages deployment tail",
		"seed:local": "node --no-warnings scripts/seed.mjs local",
		"seed:live": "node --no-warnings scripts/seed.mjs live"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20240821.1",
		"@somefreq-app/shared": "workspace:*",
		"@trpc/server": "11.0.0-rc.402",
		"@types/node": "^20.1.4",
		"drizzle-orm": "^0.30.9",
		"openid-client": "^6.8.8",
		"zod": "^3.23.5"
	},
	"nodemonConfig": {
		"delay": "400",
		"verbose": false,
		"ignore": [],
		"watch": [
			"."
		],
		"ext": "js,cjs,json"
	},
	"license": "MIT",
	"devDependencies": {
		"drizzle-kit": "^0.20.17"
	}
}
