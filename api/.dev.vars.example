# These come from the API application that you create in Zitadel
# Anything in here will override the values in wrangler for development

# For production
# https://developers.cloudflare.com/pages/functions/bindings/#secrets
# https://developers.cloudflare.com/workers/wrangler/commands/#pages
# Production secrets should be set in via the cloudflare dashboard
# or via `wrangler pages secret put API_KEY`
# Production secrets are just here for reference 
# ZITADEL_CLIENT_SECRET = ""


# For local development
ZITADEL_CLIENT_SECRET = ""
ZITADEL_CLIENT_ID = ""
ZITADEL_INTROSPECTION_ENDPOINT = ""
GOOGLE_MAPS_API_KEY = ""

SMTP_PASSWORD = ""

# Dev-only seed endpoint (POST /dev/seed). Set any value here and use the
# same value in seed:local. Leave absent in production to disable the route.
DEV_SEED_SECRET = "cfp-dev-seed"